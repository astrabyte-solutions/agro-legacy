<% const list = locals.products || []; %>
<main id="main-content" class="pt-20">
    <section class="relative h-[260px] flex items-center justify-center overflow-hidden bg-primary">
        <div class="absolute inset-0 opacity-30">
            <% if (list[0] && list[0].imageFile) { %>
            <img class="w-full h-full object-cover" src="<%= assetUrl(list[0].imageFile) %>" alt="" />
            <% } %>
        </div>
        <div class="absolute inset-0 bg-gradient-to-r from-primary/95 to-primary/80"></div>
        <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
            <nav class="text-sm text-white/80 mb-4 flex flex-wrap items-center justify-center gap-2" aria-label="Breadcrumb">
                <a href="/" class="hover:text-white">Home</a>
                <span>/</span>
                <a href="/products" class="hover:text-white">Products</a>
                <span>/</span>
                <span class="text-white font-medium"><%= categoryLabel %></span>
            </nav>
            <h1 class="text-3xl md:text-5xl font-heading font-extrabold text-white mb-2"><%= categoryLabel %></h1>
            <p class="text-white/85 text-lg"><%= list.length %> product<%= list.length !== 1 ? 's' : '' %> in this range</p>
        </div>
    </section>

    <section id="product-grid" class="py-16 max-w-7xl mx-auto px-4">
        <div class="mb-8">
            <a href="/products" class="inline-flex items-center gap-2 text-primary font-semibold hover:underline text-sm">
                <i class="fa-solid fa-arrow-left"></i> All product types
            </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <% list.forEach(function(p) { %>
            <div class="product-card group bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 transition-all hover:-translate-y-2 hover:shadow-2xl">
                <div class="relative h-64 overflow-hidden">
                    <img class="w-full h-full object-cover" src="<%= assetUrl(p.imageFile) %>" alt="<%= p.name %>" />
                    <div class="absolute top-4 right-4 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full"><%= p.categoryLabel %></div>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-heading font-bold text-secondary mb-2"><%= p.name %></h3>
                    <p class="text-gray-500 text-sm mb-6 line-clamp-3"><%= p.shortDescription %></p>
                    <div class="flex flex-col gap-3">
                        <a href="/products/<%= category %>/<%= p.slug %>" class="w-full py-3 rounded-xl border-2 border-primary text-primary font-bold hover:bg-primary hover:text-white transition-all text-center">View details</a>
                        <a href="/enquiry" class="w-full py-3 rounded-xl bg-accent text-white font-bold hover:bg-opacity-90 transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i> Enquire
                        </a>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
    </section>

    <section id="trust-badges" class="py-16 bg-primary text-white">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-white/80 max-w-xl mx-auto mb-0">Processed under strict supervision—consistent quality for domestic and export buyers.</p>
        </div>
    </section>
</main>
