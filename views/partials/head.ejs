<!DOCTYPE html>
<html lang="<%= (typeof seo !== 'undefined' && seo && seo.hreflangs && seo.hreflangs[0] && seo.hreflangs[0].lang) ? seo.hreflangs[0].lang : 'en' %>">
<head>
    <script>
        window.FontAwesomeConfig = { autoReplaceSvg: 'nest' };
    </script>
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/vendor/fontsource/poppins/400.css">
    <link rel="stylesheet" href="/vendor/fontsource/poppins/500.css">
    <link rel="stylesheet" href="/vendor/fontsource/poppins/600.css">
    <link rel="stylesheet" href="/vendor/fontsource/poppins/700.css">
    <link rel="stylesheet" href="/vendor/fontsource/poppins/800.css">
    <link rel="stylesheet" href="/vendor/fontsource/montserrat/600.css">
    <link rel="stylesheet" href="/vendor/fontsource/montserrat/700.css">
    <link rel="stylesheet" href="/vendor/fontsource/montserrat/800.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <title><%= (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : title %></title>
    <meta name="description" content="<%= (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : 'Surendra Pulses - trusted agro commodity processor and exporter from Indore, India.' %>">
    <meta name="robots" content="<%= (typeof seo !== 'undefined' && seo && seo.robots) ? seo.robots : 'index, follow' %>">
    <meta name="author" content="Surendra Pulses">
    <meta name="theme-color" content="#1B5E20">
    <link rel="canonical" href="<%= (typeof seo !== 'undefined' && seo && seo.canonical) ? seo.canonical : '' %>">
    <% if (typeof seo !== 'undefined' && seo && Array.isArray(seo.hreflangs)) { %>
    <% seo.hreflangs.forEach(function(langItem){ %>
    <link rel="alternate" hreflang="<%= langItem.lang %>" href="<%= langItem.href %>">
    <% }); %>
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Surendra Pulses">
    <meta property="og:title" content="<%= (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : title %>">
    <meta property="og:description" content="<%= (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : 'Surendra Pulses - trusted agro commodity processor and exporter from Indore, India.' %>">
    <meta property="og:url" content="<%= (typeof seo !== 'undefined' && seo && seo.canonical) ? seo.canonical : '' %>">
    <meta property="og:image" content="<%= (typeof seo !== 'undefined' && seo && seo.image) ? seo.image : '' %>">
    <meta name="twitter:card" content="<%= (typeof seo !== 'undefined' && seo && seo.twitterCard) ? seo.twitterCard : 'summary_large_image' %>">
    <meta name="twitter:title" content="<%= (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : title %>">
    <meta name="twitter:description" content="<%= (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : 'Surendra Pulses - trusted agro commodity processor and exporter from Indore, India.' %>">
    <meta name="twitter:image" content="<%= (typeof seo !== 'undefined' && seo && seo.image) ? seo.image : '' %>">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1B5E20',
                        secondary: '#6D4C41',
                        accent: '#C8A951',
                        light: '#F5F5DC',
                        beige: '#FDFBF7',
                    },
                    fontFamily: {
                        sans: ['Inter', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'system-ui', 'sans-serif'],
                        heading: ['Poppins', 'Montserrat', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'system-ui', 'sans-serif'],
                        serif: ['Georgia', 'Cambria', 'Times New Roman', 'serif'],
                        display: ['Poppins', 'Montserrat', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        .font-sans {
            font-family: Inter, Segoe UI, Roboto, Helvetica Neue, Arial, system-ui, sans-serif;
        }
        :root {
            --text-heading: #173f20;
            --text-body: #4b5563;
            --text-strong: #1f2937;
            --underline-accent: #C8A951;
        }
        html,
        body {
            font-family: Inter, "Segoe UI", Roboto, "Helvetica Neue", Arial, system-ui, sans-serif;
            color: var(--text-body);
            line-height: 1.7;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        body,
        p,
        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        li,
        a,
        button,
        input,
        select,
        textarea,
        label,
        nav,
        footer,
        header,
        section,
        article,
        span,
        div {
            font-family: Inter, "Segoe UI", Roboto, "Helvetica Neue", Arial, system-ui, sans-serif !important;
        }
        .font-heading, .font-display {
            font-family: Poppins, Montserrat, "Segoe UI", Roboto, "Helvetica Neue", Arial, system-ui, sans-serif;
            letter-spacing: -0.01em;
        }
        .font-serif { font-family: Georgia, Cambria, "Times New Roman", serif; }
        h1, h2, h3, h4 {
            color: inherit;
            line-height: 1.2;
            margin: 0;
        }
        h1 { font-weight: 800; letter-spacing: -0.02em; }
        h2 { font-weight: 700; letter-spacing: -0.015em; }
        h3, h4 { font-weight: 700; }
        p { color: inherit; line-height: 1.75; }
        strong, b { color: var(--text-strong); font-weight: 700; }
        em, i { font-style: italic; }
        u {
            text-decoration-color: var(--underline-accent);
            text-decoration-thickness: 2px;
            text-underline-offset: 3px;
        }
        .kicker {
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            font-size: 0.75rem;
        }
        .subheading {
            font-size: clamp(1.125rem, 1.5vw, 1.35rem);
            font-weight: 600;
            color: #374151;
        }
        .paragraph {
            font-size: clamp(1rem, 1.05vw, 1.125rem);
            line-height: 1.8;
        }
        ::-webkit-scrollbar { display: none; }
        .glass-effect { background: rgba(247, 244, 236, 0.95); backdrop-filter: blur(10px); }
        .hover-lift { transition: transform 0.3s ease; }
        .hover-lift:hover { transform: translateY(-5px); }
        .timeline-line { background: linear-gradient(to bottom, #C8A951 0%, #1B5E20 100%); }
        .glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); }
        .product-card:hover .product-overlay { opacity: 1; }
        .filter-btn.active { background-color: #1B5E20; color: white; border-color: #1B5E20; }
        .sticky-nav { backdrop-filter: blur(10px); background-color: rgba(255, 255, 255, 0.9); }
        .form-input:focus { border-color: #C8A951; outline: none; }
        .product-gradient { background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 100%); }
        .success-animate { animation: slideUp 0.5s ease-out forwards; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    </style>
    <% if (typeof seo !== 'undefined' && seo && Array.isArray(seo.schemas)) { %>
    <% seo.schemas.forEach(function(schema){ %>
    <script type="application/ld+json"><%- JSON.stringify(schema) %></script>
    <% }); %>
    <% } %>
    <% if (typeof extraHead !== 'undefined' && extraHead) { %><%- extraHead %><% } %>
</head>
