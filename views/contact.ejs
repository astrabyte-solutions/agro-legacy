                                    <p class="text-gray-600"><a href="mailto:surendrapulses@gmail.com" class="text-primary hover:underline">surendrapulses@gmail.com</a></p>
                                </div>
                            </div>
                        </div>

                        <div id="certifications" class="pt-6 border-t border-gray-100">
