                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-bold text-secondary uppercase">Phone Number</label>
                                        <input type="tel" placeholder="+1 (555) 000-0000" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-primary focus:ring-1 focus:ring-primary transition-all bg-gray-50/50">
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <label class="text-sm font-bold text-secondary uppercase" for="contactProductSelect">Product Interested In</label>
                                    <%- include('partials/form-product-select', { selectId: 'contactProductSelect', selectName: 'product', enquiryProductGroups: enquiryProductGroups }) %>
                                </div>

                                <div class="space-y-2">
                                    <label class="text-sm font-bold text-secondary uppercase">Your Message</label>
                                    <textarea rows="4" placeholder="How can we help you?" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-primary focus:ring-1 focus:ring-primary transition-all bg-gray-50/50"></textarea>
                                </div>

                                <button type="submit" class="w-full bg-primary text-white font-heading font-bold py-4 rounded-lg hover:bg-secondary transition-all transform hover:-translate-y-1 shadow-lg flex items-center justify-center gap-3">
