                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-bold text-secondary uppercase">Company Name</label>
                                        <input type="text" placeholder="Agro Trade Ltd." class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-primary focus:ring-1 focus:ring-primary transition-all bg-gray-50/50">
                                    </div>
                                </div>

                                <div class="grid md:grid-cols-2 gap-6">
                                    <div class="space-y-2">
