<main class="pt-20">
    <section class="relative py-16 md:py-20 bg-gradient-to-br from-primary via-primary to-secondary overflow-hidden">
        <div class="absolute inset-0 opacity-20 pointer-events-none">
            <div class="absolute top-10 right-10 w-72 h-72 rounded-full bg-accent blur-3xl"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full bg-white/10 blur-3xl"></div>
        </div>
        <div class="relative z-10 max-w-4xl mx-auto px-4 text-center text-white">
            <p class="text-accent font-bold tracking-[0.2em] uppercase text-sm mb-4">Transparency &amp; compliance</p>
            <h1 class="text-4xl md:text-5xl font-heading font-extrabold mb-4">Certificates &amp; registrations</h1>
            <p class="text-lg text-white/85 max-w-2xl mx-auto leading-relaxed">
                Official documents for export, food safety, and foreign trade. View each certificate in full or download a copy for your records.
            </p>
        </div>
    </section>

    <section class="py-16 md:py-20 bg-light">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-3 gap-8">
                <% certificates.forEach(function(c) { %>
                <article class="group bg-white rounded-2xl border border-gray-100 shadow-lg shadow-primary/5 overflow-hidden flex flex-col hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                    <div class="h-2 bg-gradient-to-r <%= c.accent %>"></div>
                    <div class="p-8 flex flex-col flex-1">
                        <div class="flex items-start justify-between gap-4 mb-6">
                            <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary text-2xl group-hover:bg-primary group-hover:text-white transition-colors">
                                <i class="<%= c.icon %>"></i>
                            </div>
                            <span class="text-xs font-bold uppercase tracking-wider text-accent bg-accent/10 px-3 py-1 rounded-full"><%= c.badge %></span>
                        </div>
                        <h2 class="text-xl font-heading font-bold text-secondary mb-2"><%= c.title %></h2>
                        <p class="text-sm text-primary font-semibold mb-3"><%= c.subtitle %></p>
                        <p class="text-gray-600 text-sm leading-relaxed mb-8 flex-1"><%= c.description %></p>
                        <div class="flex flex-col gap-3 mt-auto">
                            <a href="/certificates/<%= c.slug %>" class="w-full text-center bg-primary text-white font-bold py-3.5 rounded-xl hover:bg-opacity-90 transition-all flex items-center justify-center gap-2">
                                <i class="fa-regular fa-eye"></i> View certificate
                            </a>
                            <a href="<%= assetUrl(c.fileName) %>" download="<%= c.downloadName %>" class="w-full text-center border-2 border-primary text-primary font-bold py-3 rounded-xl hover:bg-primary hover:text-white transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-download"></i> Download PDF
                            </a>
                        </div>
                    </div>
                </article>
                <% }); %>
            </div>
        </div>
    </section>

    <section class="py-14 bg-white border-t border-gray-100">
        <div class="max-w-3xl mx-auto px-4 text-center">
            <p class="text-gray-600 text-sm leading-relaxed">
                Documents are provided for business verification. For attested copies or additional compliance paperwork, please
                <a href="/contact" class="text-primary font-semibold hover:underline">contact us</a>
                or use the
                <a href="/enquiry" class="text-primary font-semibold hover:underline">enquiry form</a>.
            </p>
        </div>
    </section>
</main>
